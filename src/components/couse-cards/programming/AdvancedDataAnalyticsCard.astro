---
import CourseCardLayout from "../../../layouts/CourseCardLayout.astro";
import CourseCardToolTag from "../../CourseCardToolTag.astro";

const courseCardDetails = {
  refLink: "/courses/programming/advanced-data-analytics/",
  icon: "/images/course-icons/data-analytics.png",
  lazyLoadIconImg: false,
  name: "Advanced Data Analytics",
  description: "Master advanced analytics with Python, Power BI, and AI...",
  duration: "4-6",
};
---

<CourseCardLayout {courseCardDetails}>
  <slot slot="course-tool-tags-slot">
    <CourseCardToolTag toolName="Python" />
    <CourseCardToolTag toolName="SQL" />
    <CourseCardToolTag toolName="Power BI" />
    <CourseCardToolTag toolName="AI Tools" />
  </slot>
</CourseCardLayout>
