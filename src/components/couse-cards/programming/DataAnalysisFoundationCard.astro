---
import CourseCardLayout from "../../../layouts/CourseCardLayout.astro";
import CourseCardToolTag from "../../CourseCardToolTag.astro";

const courseCardDetails = {
  refLink: "/courses/programming/data-analysis-foundation/",
  icon: "/images/course-icons/data-analysis.png",
  lazyLoadIconImg: false,
  name: "Data Analysis Foundation",
  description: "Turn raw data into meaningful insights with analytics tools...",
  duration: "2-3",
};
---

<CourseCardLayout {courseCardDetails}>
  <slot slot="course-tool-tags-slot">
    <CourseCardToolTag toolName="Excel" />
    <CourseCardToolTag toolName="SQL" />
    <CourseCardToolTag toolName="AI Tools" />
  </slot>
</CourseCardLayout>
