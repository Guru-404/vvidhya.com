---
import IndCourseDetailsLayout from "../../../layouts/IndCourseDetailsLayout.astro";

const metadata = {
  title: "Learn Digital Marketing at V.Vidhya",
  description:
    "Get certified in Digital Marketing at V.Vidhya in Surat. Learn SEO, Google Ads, Social Media Marketing, Content Strategy & more.",
};

const courseDetails = {
  name: "Digital Marketing",
  duration: "2-4",
  image: "/images/doodles/woman-doing-social-media.svg",
  imgAlt: "an Illustration of a woman interacting on social media",
  overview:
    "This course provides a comprehensive introduction to digital marketing, equipping you with the skills needed to grow businesses, build brands, and drive online engagement. Over 2-4 months, you will learn how to effectively market products and services using various digital platforms, including social media, search engines, email marketing, and paid advertising. The course covers SEO (Search Engine Optimization) to improve website visibility, Google Ads & Facebook Ads for targeted marketing, content marketing for brand storytelling, and email marketing strategies to nurture leads. You'll also explore analytics tools like Google Analytics to track performance and optimize campaigns. By the end of the course, you'll be able to develop and execute result-driven digital marketing strategies for businesses, personal brands, or freelance projects. Whether you're a beginner or looking to advance your skills, this course will provide hands-on experience with real-world projects to make you job-ready.",
};
---

<IndCourseDetailsLayout
  metadata={metadata}
  navSection="none"
  courseDetails={courseDetails}
>
  <slot slot="course-curriculum-slot">
    <li class="ind-course-imp-text">Introduction to Digital Marketing</li>
    <ul class="ind-course-sublist">
      <li>What is Digital Marketing?</li>
      <li>Benefits of Digital Marketing</li>
      <li>Digital vs. Traditional Marketing</li>
      <li>Digital Marketing Process Overview</li>
      <li>Types of Visibility & Customer Journey</li>
      <li>Target Audience, Traffic & Lead Conversion</li>
      <li>Marketing Funnel & Conversion Process</li>
    </ul>

    <li class="ind-course-imp-text">Search Engine Optimization (SEO)</li>
    <ul class="ind-course-sublist">
      <li>Introduction to SEO & SERP</li>
      <li>Keyword Research & Search Intent</li>
      <li>On-Page & Off-Page Optimization</li>
      <li>Technical SEO Fundamentals</li>
      <li>Search Engine Algorithms</li>
      <li>SEO Tools & Website Audit</li>
      <li>Local SEO & Google Business Profile</li>
    </ul>

    <li class="ind-course-imp-text">Answer Engine Optimization (AEO)</li>
    <ul class="ind-course-sublist">
      <li>Introduction to AEO</li>
      <li>SEO vs. AEO</li>
      <li>Optimizing Content for AI Search</li>
      <li>Featured Snippets & Zero-Click Searches</li>
      <li>Structured Data & Schema Markup</li>
      <li>Voice Search Optimization</li>
      <li>Writing AI-Friendly Content</li>
    </ul>

    <li class="ind-course-imp-text">Search Engine Marketing (SEM)</li>
    <ul class="ind-course-sublist">
      <li>Introduction to Paid Advertising</li>
      <li>Google Ads Account Setup</li>
      <li>Types of Campaigns, Campaign Setup & Structure</li>
      <li>Conversion Tracking</li>
      <li>Performance Analysis & Optimization</li>
    </ul>

    <li class="ind-course-imp-text">Social Media Marketing (SMM)</li>
    <ul class="ind-course-sublist">
      <li>Social Media Platforms Overview</li>
      <li>Social Media vs. Search Engine Ads</li>
      <li>Creating & Optimizing Social Media Ads</li>
      <li>Business Marketing Strategies</li>
      <li>App Marketing & Optimization</li>
      <li>Social Media Management Tools</li>
    </ul>

    <li class="ind-course-imp-text">Social Media Optimization (SMO)</li>
    <ul class="ind-course-sublist">
      <li>Role of Social Media in Digital Marketing</li>
      <li>Choosing the Right Social Media Platform</li>
      <li>Social Media Engagement & Growth Strategies</li>
      <li>Use of Social Media Management Tools</li>
      <li>Influencer & Creator Marketing</li>
    </ul>

    <li class="ind-course-imp-text">Content Marketing</li>
    <ul class="ind-course-sublist">
      <li>Introduction to Content Marketing</li>
      <li>Content Marketing Strategy</li>
      <li>Writing Great & Compelling Content</li>
      <li>Keyword Research for Content Ideas</li>
      <li>Unique Headline Creation Techniques</li>
      <li>Tools for Content Creation & Marketing</li>
      <li>Cross-Platform Content Marketing Strategies</li>
    </ul>

    <li class="ind-course-imp-text">Email & WhatsApp Marketing</li>
    <ul class="ind-course-sublist">
      <li>Introduction to Email Marketing</li>
      <li>Email Marketing Software</li>
      <li>Audience Segmentation & Lead Generation</li>
      <li>Email Automation & A/B Testing</li>
      <li>WhatsApp Business & Broadcast Marketing</li>
    </ul>

    <li class="ind-course-imp-text">Ecommerce & Marketplace Marketing</li>
    <ul class="ind-course-sublist">
      <li>Selling on Online Marketplaces</li>
      <li>Product Listing Optimization</li>
      <li>Ecommerce Marketing Strategies</li>
      <li>Customer Reviews & Reputation Management</li>
      <li>Conversion Rate Optimization (CRO)</li>
    </ul>

    <li class="ind-course-imp-text">Affiliate & Referral Marketing</li>
    <ul class="ind-course-sublist">
      <li>Introduction to Affiliate Marketing</li>
      <li>Affiliate Networks & Platforms</li>
      <li>Choosing the Right Niche</li>
      <li>Lead Generation & Conversion Strategies</li>
      <li>Referral Marketing Strategies</li>
      <li>Performance Tracking & ROI</li>
    </ul>

    <li class="ind-course-imp-text">AI for Digital Marketing</li>
    <ul class="ind-course-sublist">
      <li>Using ChatGPT & Gemini for Marketing</li>
      <li>AI for Content Writing & Copywriting</li>
      <li>AI for SEO & Keyword Research</li>
      <li>AI for Image & Video Generation</li>
      <li>AI Productivity & Automation Tools</li>
      <li>Prompt Engineering for Marketers</li>
      <li>Cross-Platform Content Marketing Strategies</li>
    </ul>

    <li class="ind-course-imp-text">Live Projects & Case Studies</li>
    <ul class="ind-course-sublist">
      <li>SEO Audit of a Live Website</li>
      <li>Google Ads Campaign Planning</li>
      <li>Social Media Campaign Creation</li>
      <li>AI-powered Marketing Workflow</li>
      <li>Complete Digital Marketing Project</li>
    </ul>
  </slot>
</IndCourseDetailsLayout>
